<article class="lcard <%= variant %>">
  <div class="lcard-media">
    <%- include('cover', { item: l, alt: l.title }) %>
    <% if (l.status === 'reservado') { %><span class="badge badge-res">Reservado</span><% } else { %><span class="badge">Remodelado</span><% } %>
    <% if (l.photo_count > 1) { %><span class="photo-count" title="<%= l.photo_count %> fotografias"><%- ico('image', 14) %><%= l.photo_count %></span><% } %>
    <span class="lcard-more" aria-hidden="true"><span>Ver detalhes e fotografias</span></span>
  </div>
  <div class="lcard-body">
    <span class="lcard-city"><%- ico('pin', 15) %><%= l.city %></span>
    <h3><%= l.title %></h3>
    <div class="lcard-price"><%= euro.format(l.price) %></div>
    <div class="lcard-meta">
      <% if (l.area) { %><span><%- ico('area', 16) %><%= l.area %> m²</span><% } %>
      <% if (l.bedrooms != null) { %><span><%- ico('bed', 16) %>T<%= l.bedrooms %></span><% } %>
      <% if (l.bathrooms != null) { %><span><%- ico('bath', 16) %><%= l.bathrooms %></span><% } %>
    </div>
  </div>
  <a class="cover-link" href="/imoveis/<%= l.id %>" aria-label="Ver <%= l.title %>"></a>
</article>
