<%
  const _title = locals.title ? (locals.page === 'home' ? locals.title + ' — CosmicLounge' : locals.title + ' · CosmicLounge') : 'CosmicLounge — Compra e venda de imóveis';
  const _desc = locals.desc || 'A CosmicLounge compra o seu imóvel, remodela-o e volta a colocá-lo no mercado. Proposta em 48 horas úteis, sem intermediários.';
  const _page = locals.page || '';
  const _bare = locals.bare === true;
%><!doctype html>
<html lang="pt-PT">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= _title %></title>
  <meta name="description" content="<%= _desc %>">
  <meta name="theme-color" content="#060e1d">
  <meta property="og:title" content="<%= _title %>">
  <meta property="og:description" content="<%= _desc %>">
  <meta property="og:type" content="website">
  <meta property="og:image" content="<%= siteUrl %>/img/logo-lockup.png">
  <link rel="icon" type="image/png" href="/img/favicon-64.png">
  <link rel="apple-touch-icon" href="/img/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v=19">
</head>
<body class="page-<%= _page %><%= user ? ' is-in' : '' %><%= user && user.role === 'admin' ? ' is-admin' : '' %>">
<a class="sr-only" href="#main">Saltar para o conteúdo</a>

<% if (!_bare) { %>
<header class="site-header" id="header">
  <div class="topbar">
    <div class="wrap">
      <div class="topbar-l">
        <a href="tel:<%= company.phoneHref %>"><%- ico('phone', 14) %><%= company.phone %></a>
        <a href="mailto:<%= company.email %>"><%- ico('mail', 14) %><%= company.email %></a>
      </div>
      <div class="topbar-r"><span><%- ico('clock', 14) %><%= company.hours %></span></div>
    </div>
  </div>
  <div class="wrap nav">
    <a class="brand" href="/" aria-label="CosmicLounge — página inicial">
      <img src="/img/logo-mark.png" alt="">
      <span class="brand-word"><strong>COSMIC</strong>LOUNGE</span>
    </a>
    <nav class="nav-links" id="navLinks" aria-label="Principal">
      <a href="/imoveis" class="<%= _page === 'imoveis' ? 'is-active' : '' %>">Imóveis</a>
      <a href="/trabalhos" class="<%= _page === 'trabalhos' ? 'is-active' : '' %>">Trabalhos</a>
      <a href="/#como-funciona" data-hash>Como funciona</a>
      <a href="/sobre" class="<%= _page === 'sobre' ? 'is-active' : '' %>">Sobre nós</a>
      <a href="/contacto" class="<%= _page === 'contacto' ? 'is-active' : '' %>">Contacto</a>
      <% if (user) { %>
        <% if (user.role === 'admin') { %><a href="/admin" class="<%= _page === 'admin' ? 'is-active' : '' %>">Painel</a><% } %>
        <a href="/conta" class="drawer-only <%= _page === 'conta' ? 'is-active' : '' %>">A minha conta</a>
        <form method="post" action="/logout" class="inline drawer-only"><button type="submit" class="logout-btn">Terminar sessão</button></form>
      <% } else { %>
        <a href="/login" class="drawer-only <%= _page === 'login' ? 'is-active' : '' %>">Entrar</a>
      <% } %>
      <a class="btn btn-gold btn-sm only-drawer" href="/vender">Vender a minha casa</a>
    </nav>
    <div class="nav-actions">
      <% if (user) { %>
        <a class="btn btn-ghost btn-sm nav-auth nav-account" href="/conta"><%- ico('user', 16) %>Conta</a>
        <form method="post" action="/logout" class="inline nav-auth"><button type="submit" class="btn btn-ghost btn-sm">Sair</button></form>
      <% } else { %>
        <a class="btn btn-ghost btn-sm nav-auth nav-login" href="/login"><%- ico('user', 16) %>Entrar</a>
      <% } %>
      <a class="btn btn-gold btn-sm nav-cta" href="/vender">Vender a minha casa</a>
      <button class="burger" id="burger" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="navLinks"><%- ico('menu', 22) %></button>
    </div>
  </div>
  <div class="progress" id="progress" aria-hidden="true"></div>
</header>
<% } %>
<main id="main">
