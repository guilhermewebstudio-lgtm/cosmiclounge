<% locals.bare = true; %>
<%- include('partials/head') %>
<div class="auth">
  <a class="auth-back brand" href="/" aria-label="Voltar ao início"><img src="/img/logo-mark.png" alt="" style="width:38px"><span class="brand-word"><strong>COSMIC</strong>LOUNGE</span></a>
  <div class="auth-art">
      <div class="auth-art-inner">
      <img src="/img/logo-mark.png" alt="">
      <h2>Venda a sua casa sem complicações</h2>
      <p>Crie a sua conta gratuita, submeta o imóvel e receba a nossa proposta em 48 horas úteis.</p>
    </div>
  </div>
  <div class="auth-form-side">
    <div class="auth-card">
      <h1>Criar conta</h1>
      <p class="muted">É grátis e demora menos de um minuto.</p>
      <%- include('partials/flash') %>
      <form method="post" action="/registo" novalidate>
        <input type="hidden" name="next" value="<%= next %>">
        <div class="field"><label for="name">Nome completo</label><input class="input" id="name" name="name" value="<%= form.name || '' %>" required autocomplete="name" autofocus></div>
        <div class="grid-2">
          <div class="field"><label for="email">Email</label><input class="input" id="email" type="email" name="email" value="<%= form.email || '' %>" required autocomplete="email"></div>
          <div class="field"><label for="phone">Telemóvel</label><input class="input" id="phone" type="tel" name="phone" value="<%= form.phone || '' %>" autocomplete="tel"></div>
        </div>
        <div class="field">
          <label for="password">Palavra-passe</label>
          <div class="pw"><input class="input" id="password" type="password" name="password" required minlength="8" autocomplete="new-password"><button type="button" data-toggle-pw="password" aria-label="Mostrar palavra-passe"><%- ico('eye', 19) %></button></div>
          <span class="hint">Mínimo de 8 caracteres.</span>
        </div>
        <div class="field">
          <label for="password2">Repetir palavra-passe</label>
          <div class="pw"><input class="input" id="password2" type="password" name="password2" required autocomplete="new-password"><button type="button" data-toggle-pw="password2" aria-label="Mostrar palavra-passe"><%- ico('eye', 19) %></button></div>
        </div>
        <button class="btn btn-gold btn-block" type="submit" style="margin-top:8px">Criar conta</button>
      </form>
      <p class="auth-alt">Já tem conta? <a href="/login<%= next ? '?next=' + encodeURIComponent(next) : '' %>">Entrar</a></p>
    </div>
  </div>
</div>
<%- include('partials/foot') %>
